# --- Email notifications (recommended) ---------------------------------
# Free account at https://resend.com. Once you have a key, every
# consultation request is emailed to you immediately.
RESEND_API_KEY=

# Optional — who receives the notification email. Defaults to
# commandcenterai.contact@gmail.com if not set.
CONTACT_NOTIFY_EMAIL=commandcenterai.contact@gmail.com

# --- CRM connection (optional, add later) -------------------------------
# Point this at a Zapier/Make "Catch Webhook" URL, an Airtable automation
# webhook, or your future Command Center AI CRM's ingest endpoint. Every
# form submission will be POSTed there as JSON the moment it comes in.
CRM_WEBHOOK_URL=

# --- Database (required for assessment, proposals, orders, payments) ----
# Any Postgres-compatible provider works: Vercel Postgres, Supabase, Neon.
# After setting this, run: npx prisma migrate dev --name init
# then:                    npm run db:seed
DATABASE_URL=

# --- Stripe (Sandbox/Test Mode keys — Stripe Dashboard > Developers > API keys, toggle "Test mode" on) --
# Never commit real keys. Set these in Vercel Project Settings for
# production, and in .env.local (already gitignored) for local dev.
STRIPE_SECRET_KEY=
# NEXT_PUBLIC_ prefix makes this readable client-side if a future phase adds
# embedded Stripe Elements. Not yet read by any code — the current checkout
# flow (app/api/checkout/session/route.ts) redirects server-side to Stripe's
# hosted page and only needs STRIPE_SECRET_KEY. Kept here so it's ready.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From Stripe CLI (`stripe listen`) for local dev, or the Dashboard's
# webhook endpoint config for production. Do not create the production
# webhook endpoint until the site with /api/webhooks/stripe is live.
STRIPE_WEBHOOK_SECRET=

# --- App -----------------------------------------------------------------
# Used to build Stripe success/cancel redirect URLs.
NEXT_PUBLIC_APP_URL=https://commandcenterai.net

# --- Admin / Owner Dashboard (Priority 6) --------------------------------
# AUTH_SECRET signs the admin session cookie. Generate with:
#   openssl rand -base64 32
# Not obtained from any service — you generate this yourself, once, and
# reuse the same value across environments so sessions stay valid.
AUTH_SECRET=

# The email/password for your first dashboard login. Only used by
# `npm run db:seed` to create that one admin account — after that, you can
# leave ADMIN_INITIAL_PASSWORD blank again (or remove it); it's not read
# anywhere else. Choose your own values; nothing to "obtain" from a service.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# --- AI Sales & Support Chatbot ------------------------------------------
# Uses OpenAI (gpt-4o-mini) via a plain fetch — no SDK — matching the
# proven architecture already used by the Command Center AI Academy
# project. Get a key from: https://platform.openai.com/api-keys
# Create a separate key for this project rather than reusing the Academy's.
# Vercel project: command-center-ai-website
# Environments: Production, Preview, and Development
# Without this, the chat widget still renders but responds with a clear
# customer-safe "temporarily unavailable" message instead of crashing —
# the real reason is only ever logged server-side, never shown to visitors.
OPENAI_API_KEY=

# --- Cron (protects /api/cron/mark-abandoned from being called by anyone
# other than Vercel's own scheduler; optional but recommended) -----------
CRON_SECRET=
